# Chỉ dùng trong LAN. Copy thành .env rồi đổi mọi mật khẩu trước khi chạy.
POSTGRES_PASSWORD=doi_mat_khau_postgres
# Tài khoản MQTT của backend (ingest + API). Không dùng tài khoản này trên Pi.
MQTT_USERNAME=health_watch
MQTT_PASSWORD=doi_mat_khau_backend
# Thiết bị thật được phép gửi dữ liệu: id:mat_khau, nhiều thiết bị cách nhau dấu phẩy.
# id phải trùng MQTT_DEVICE_ID và MQTT_USERNAME trong health_watch/.env trên Pi.
# Mật khẩu không chứa dấu phẩy hoặc khoảng trắng.
MQTT_DEVICES=pi-watch-001:doi_mat_khau_rieng_cho_pi_nay
# Múi giờ để chia số bước theo ngày.
LOCAL_TIMEZONE=Asia/Ho_Chi_Minh
