{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-watch.local/contracts/mqtt/command.v1.schema.json",
  "title": "Health Watch device command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "device_id", "command_type", "active", "duration_s", "issued_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "command_id": { "type": "string", "format": "uuid" },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "command_type": { "const": "remote_alert" },
    "active": { "type": "boolean" },
    "duration_s": { "type": "integer", "minimum": 1, "maximum": 60 },
    "issued_at": { "type": "string", "format": "date-time" }
  }
}
