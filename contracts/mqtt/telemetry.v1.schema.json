{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Watch telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "boot_id", "sequence", "measured_at", "metrics"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "boot_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "measured_at": { "type": "string", "format": "date-time" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heart_rate_bpm", "finger_present", "steps_session", "distance_m_session", "calories_kcal_session"],
      "properties": {
        "heart_rate_bpm": { "type": ["integer", "null"], "minimum": 0 },
        "finger_present": { "type": "boolean" },
        "steps_session": { "type": "integer", "minimum": 0 },
        "distance_m_session": { "type": "number", "minimum": 0 },
        "calories_kcal_session": { "type": "number", "minimum": 0 }
      }
    }
  }
}
