{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-watch.local/contracts/mqtt/alert-state.v1.schema.json",
  "title": "Health Watch alert output state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "boot_id", "buzzer_active", "red_led_active", "source", "last_command_id", "expires_at", "reported_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "boot_id": { "type": "string", "format": "uuid" },
    "buzzer_active": { "type": "boolean" },
    "red_led_active": { "type": "boolean" },
    "source": { "enum": ["normal", "remote", "sos", "fall"] },
    "last_command_id": { "type": ["string", "null"], "format": "uuid" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "reported_at": { "type": "string", "format": "date-time" }
  }
}
