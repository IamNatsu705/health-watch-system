{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Watch device event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "device_id", "boot_id", "sequence", "event_type", "occurred_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "boot_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "event_type": {
      "enum": ["fall_detected", "fall_acknowledged", "sos_pressed", "sos_released"]
    },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
