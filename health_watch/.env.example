# Đổi MQTT_HOST thành IP LAN của máy tính chạy Docker Compose, không dùng localhost.
MQTT_ENABLED=1
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
# Mỗi Pi có tài khoản MQTT riêng: tên đăng nhập phải trùng MQTT_DEVICE_ID và
# mật khẩu phải khớp dòng tương ứng trong MQTT_DEVICES ở infra/local/.env.
MQTT_DEVICE_ID=pi-watch-001
MQTT_USERNAME=pi-watch-001
MQTT_PASSWORD=doi_mat_khau_rieng_cho_pi_nay
# AWS IoT Core: đổi host/port, bật TLS và trỏ tới ba file chứng thư trên Pi.
# Khi MQTT_TLS_ENABLED=1, chương trình không dùng MQTT_USERNAME/MQTT_PASSWORD.
MQTT_TLS_ENABLED=0
# MQTT_CA_CERT=/home/pi/projects/health_watch/certs/AmazonRootCA1.pem
# MQTT_CLIENT_CERT=/home/pi/projects/health_watch/certs/healthy-watch-pi.cert.pem
# MQTT_CLIENT_KEY=/home/pi/projects/health_watch/certs/healthy-watch-pi.private.key
MQTT_PUBLISH_INTERVAL_S=1.0
MQTT_KEEPALIVE_S=30
MQTT_OUTBOX_SIZE=200
# 1 = ghi PPG thô của MAX30102 ra logs/ppg_*.csv trong khi hệ thống chạy (file lớn).
PPG_CSV_LOG=0
